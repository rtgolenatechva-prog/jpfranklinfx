# Resend — get your API key from resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# GHL (GoHighLevel) — server-side only
GHL_API_KEY=pit-your_private_integration_token
GHL_LOCATION_ID=your_location_id
GHL_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
GHL_PLUMBING_FORM_ID=ghl_form_widget_id_from_dashboard

# GHL — client-side (NEXT_PUBLIC_ required for iframe embed)
NEXT_PUBLIC_GHL_PLUMBING_FORM_ID=ghl_form_widget_id_from_dashboard

# GHL pipeline (look up with GET /opportunities/pipelines)
GHL_PIPELINE_ID=your_pipeline_id
GHL_STAGE_ID=your_stage_id

# ElevenLabs — agent is routed via GHL Native Voice AI (no SIP URI needed)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_agent_id
